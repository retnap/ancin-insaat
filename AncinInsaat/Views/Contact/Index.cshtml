@model AncinInsaat.Models.ContactPageViewModel

@* Title/description/canonical/OG/ContactPage schema come from
   ViewData["Seo"] + ViewData["SeoPageType"], set in ContactController.Index
   via ISeoService — see _Layout.cshtml's <head> and
   SeoStructuredDataViewComponent.

   Folkart-reference revision (2026-08-17, project owner-supplied
   "İletişim" screenshot) — page flow rebuilt to match that reference:
   Breadcrumb → plain page heading + short intro (no Hero Banner) →
   Contact Form + Contact Information → Office Location (Map, no heading,
   full-width) → Social Media. Same "no Hero Banner, plain heading" pattern
   About/Index.cshtml and Values/Index.cshtml already established for their
   own Folkart-reference revisions. HeroBannerStandard is intentionally not
   invoked here — neither the component nor its assets were modified;
   it's simply unused by this page now. Social Media section, Footer, CTA
   Banner, Partner Logos and Floating Contact Button are untouched — the
   reference is only a source for this page's own content layout, not for
   the shared chrome around it. *@

@{
    var breadcrumbTrail = new List<AncinInsaat.ViewComponents.BreadcrumbItem>
    {
        new() { Label = "İletişim" }
    };
}
@await Component.InvokeAsync("Breadcrumb", new { trail = breadcrumbTrail, homeLabel = "Anasayfa" })

<section class="section contact-heading-section">
    <div class="container">
        <h1 id="contact-heading" class="contact-heading">İletişim</h1>
        <p class="contact-intro">Projeleriniz ve sorularınız için ekibimiz sizi dinlemeye hazır.</p>
    </div>
</section>

<section class="section contact-section" id="contact-form" aria-label="İletişim bilgileri ve formu">
    <div class="container">
        <partial name="_ContactInfo" model="Model" />
    </div>
</section>

@if (!string.IsNullOrWhiteSpace(Model.MapEmbedUrl) || !string.IsNullOrWhiteSpace(Model.MapLinkUrl))
{
    <section class="section contact-map-section" aria-label="Konum">
        <div class="container">
            <div data-reveal>
                @await Component.InvokeAsync("Map", new { embedUrl = Model.MapEmbedUrl, linkUrl = Model.MapLinkUrl })
            </div>
        </div>
    </section>
}

@* "Bizi Takip Edin" social-media section removed from this page only
   (2026-08-17, project owner-requested) — the SocialMediaViewComponent
   itself, the global Footer's own social icons, and every other page that
   still calls this section are untouched. *@
