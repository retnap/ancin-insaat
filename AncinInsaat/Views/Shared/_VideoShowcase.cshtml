@model VideoShowcaseModel

@{
    var modalId = $"video-modal-{Model.Id}";
}

@* The trigger and its modal are siblings, not nested — .video-showcase
   carries the [data-reveal] scroll-in animation (opacity/transform), and
   a non-"none" transform on an ancestor becomes the containing block for
   any position: fixed descendant. Nesting the modal inside would trap
   its full-viewport overlay to this element's box once revealed instead
   of the viewport. site.js pairs them at runtime via aria-controls. *@

<div class="video-showcase @Model.CssClass" data-reveal>
    <button type="button"
            class="video-showcase-trigger"
            aria-haspopup="dialog"
            aria-controls="@modalId"
            data-video-trigger>
        <img class="video-showcase-poster" src="@Model.PosterSrc" alt="@Model.PosterAlt" loading="lazy" decoding="async" />
        <span class="video-showcase-play" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="28" height="28">
                <path d="M8 5.5v13c0 .8.9 1.3 1.6.9l10-6.5c.6-.4.6-1.4 0-1.8l-10-6.5c-.7-.4-1.6.1-1.6.9z" fill="currentColor" />
            </svg>
        </span>
        <span class="sr-only">@Model.Title</span>
    </button>
</div>

<div class="video-modal"
     id="@modalId"
     role="dialog"
     aria-modal="true"
     aria-label="@Model.Title"
     data-video-modal
     hidden>
    <div class="video-modal-backdrop" data-video-close></div>
    <div class="video-modal-panel">
        <button type="button" class="video-modal-close" data-video-close aria-label="Kapat">
            <svg viewBox="0 0 24 24" width="20" height="20">
                <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none" />
            </svg>
        </button>
        <div class="video-modal-frame">
            @if (!string.IsNullOrWhiteSpace(Model.VideoSrc))
            {
                <video class="video-modal-video" controls playsinline poster="@Model.PosterSrc" data-video-element>
                    <source src="@Model.VideoSrc" type="video/mp4" />
                </video>
            }
            else
            {
                <div class="video-modal-placeholder">
                    <img class="video-modal-placeholder-image" src="@Model.PosterSrc" alt="" aria-hidden="true" />
                    <p class="video-modal-placeholder-text">Tanıtım videosu yakında eklenecektir.</p>
                </div>
            }
        </div>
    </div>
</div>
