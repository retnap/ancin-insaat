@model AncinInsaat.ViewComponents.HeroBannerProjectDetailViewModel

@{
    var heroStyle = $"--hero-bg-image: url('{Model.BackgroundImageUrl}')";
    var hasHeadingLogo = !string.IsNullOrWhiteSpace(Model.HeadingLogoImageUrl);

    // Ferhunde Hanım Apt. (2026-08-21 follow-up client request) — even after
    // the shared .hero-heading--font-montserrat-bold size reduction below,
    // this project's own title still read slightly too large; Q-Latis
    // (the only other project using that same font class) was already
    // correct at that scale, so the further reduction is scoped to this
    // slug only via its own modifier class (site.css) rather than lowering
    // .hero-heading--font-montserrat-bold itself, which would also shrink
    // Q-Latis. Project Detail only — the Home Hero resolves its own heading
    // class straight from ProjectHeroFontMap, never from this file.
    var headingSlugModifierClass = Model.Slug == "ferhunde-hanim-apt" ? " hero-heading--ferhunde-hanim-apt" : "";
    var headingClass = "hero-heading hero-heading--project" + (hasHeadingLogo || string.IsNullOrWhiteSpace(Model.HeadingFontModifierClass) ? "" : $" {Model.HeadingFontModifierClass}") + headingSlugModifierClass;

    // Several projects' supplied logo files have transparent padding baked
    // in asymmetrically around their own canvas (unlike Nysa Gold's and
    // D-Latis's tightly-trimmed files), so their visible artwork sits inset
    // from the image element's own left edge. Each modifier below (site.css)
    // nudges its project's rendered image left by that project's own
    // measured padding percentage so the visible logo lines up with "Devam
    // Ediyor"/"Tamamlandı"'s left edge — every project with no entry here
    // keeps the base .hero-heading-logo-img rule unchanged.
    var headingLogoImgModifierClass = Model.Slug switch
    {
        "le-jardin" => " hero-heading-logo-img--le-jardin",
        "la-fiore-karabag" or "la-fiore-karabag-2-etap" => " hero-heading-logo-img--la-fiore-karabag",
        "kuyulu-la-via-villalar-birinci-etap" => " hero-heading-logo-img--lavia",
        "tralles-gold" => " hero-heading-logo-img--tralles-gold",
        "alinda-gold" => " hero-heading-logo-img--alinda-gold",
        "magnesia-gold" => " hero-heading-logo-img--magnesia-gold",
        "nlatis" => " hero-heading-logo-img--nlatis",
        _ => ""
    };
    var headingLogoImgClass = "hero-heading-logo-img" + headingLogoImgModifierClass;

    // Alinda Gold Residence, Magnesia Gold Residence, Tralles Gold Residence
    // and N Latis (client request, 2026-08-17) — the Hero's "Kataloğu
    // İncele" button is hidden for these four projects specifically, while
    // CatalogueUrl itself stays untouched so the Katalog download inside
    // Daire Planları (_FloorPlans.cshtml) keeps working. Same slug-gated
    // pattern already used by _FloorPlans.cshtml's PLANLAR heading.
    var hideCatalogueHeroButton = Model.Slug is "alinda-gold" or "magnesia-gold" or "tralles-gold" or "nlatis";
}

@* Nysa Gold Residence reference redesign (2026-08-07), rolled out as the
   single Hero architecture for every Project Detail page (2026-08-08):
   transparent navbar overlapping the Hero image, left-aligned content,
   floating social icons, segmented bottom-center CTA bar, cinematic
   full-bleed presentation. lang="en" on the heading (not "tr", the page's
   own language — see _Layout.cshtml) is required for text-transform:
   uppercase to render an ASCII "I" — with Turkish casing rules a lowercase
   "i" instead becomes "İ" (dotted capital I), the cause of the
   "RESİDENCE" defect. Project names are brand names, not Turkish prose, so
   overriding the language here is correct rather than a workaround. *@
<section class="hero hero--project-detail hero--overlap-navbar hero--full-viewport" style="@heroStyle" aria-labelledby="hero-heading">
    <div class="hero-bg" aria-hidden="true"></div>

    <nav class="hero-social-nav" aria-label="Sosyal medya">
        @await Component.InvokeAsync("SocialMedia")
    </nav>

    <div class="container hero-inner">
        <div class="hero-content hero-content--start">
            @if (!string.IsNullOrWhiteSpace(Model.StatusLabel))
            {
                <span class="project-status-badge @Model.StatusModifierClass hero-status-badge">@Model.StatusLabel</span>
            }
            @if (hasHeadingLogo)
            {
                <h1 id="hero-heading" class="@headingClass">
                    <span class="hero-heading-lockup">
                        <img src="@Model.HeadingLogoImageUrl" alt="@Model.Heading" class="@headingLogoImgClass">
                        @if (!string.IsNullOrWhiteSpace(Model.HeadingBadgeImageUrl))
                        {
                            <img src="@Model.HeadingBadgeImageUrl" alt="" aria-hidden="true" class="hero-heading-badge-img">
                        }
                    </span>
                </h1>
            }
            else
            {
                <h1 id="hero-heading" class="@headingClass" lang="en">@Model.Heading</h1>
                @if (!string.IsNullOrWhiteSpace(Model.Subheading))
                {
                    <p class="hero-subheading">@Model.Subheading</p>
                }
            }
        </div>
    </div>

    <div class="hero-bottom">
        <div class="hero-actions hero-actions--attached">
            @if (Model.SitePlanImageUrls.Count > 0)
            {
                @* La Fiore Karabağ 2. Etap Vaziyet Planı/Concept/Gallery
                   phase (2026-08-09) — only the first image renders as the
                   visible button; any remaining images render as hidden
                   same-group trigger elements purely so the Media Viewer's
                   generic group mechanism (see site.js) discovers them and
                   activates Prev/Next/counter. Every other project still has
                   exactly 1 SitePlanImageUrls entry, so no hidden elements
                   render and this is byte-identical to before. *@
                <button type="button"
                        class="btn btn-hero-segment btn-hero-segment--siteplan"
                        data-media-viewer-trigger
                        data-media-viewer-group="site-plan"
                        data-media-viewer-src="@Model.SitePlanImageUrls[0]"
                        data-media-viewer-alt="@(Model.Heading) vaziyet planı">
                    Vaziyet Planı
                </button>
                @for (var sitePlanIndex = 1; sitePlanIndex < Model.SitePlanImageUrls.Count; sitePlanIndex++)
                {
                    <button type="button"
                            hidden
                            tabindex="-1"
                            aria-hidden="true"
                            data-media-viewer-trigger
                            data-media-viewer-group="site-plan"
                            data-media-viewer-src="@Model.SitePlanImageUrls[sitePlanIndex]"
                            data-media-viewer-alt="@(Model.Heading) vaziyet planı @(sitePlanIndex + 1)"></button>
                }
            }
            else if (Model.SitePlanComingSoon)
            {
                @* Alinda Gold Residence revision (2026-08-10) — no site plan
                   supplied yet. Renders the same button in the same
                   position instead of omitting it, showing a Coming Soon
                   toast on click via the shared _Toast.cshtml/site.js
                   architecture (same mechanism as the Catalogue toast
                   below). SitePlanComingSoon is false for every other
                   project, so this branch never runs for them. *@
                <button type="button"
                        class="btn btn-hero-segment btn-hero-segment--siteplan"
                        data-toast-trigger
                        data-toast-message="Vaziyet planı yakında eklenecektir.">
                    Vaziyet Planı
                </button>
            }
            @if (!string.IsNullOrWhiteSpace(Model.CatalogueUrl) && !hideCatalogueHeroButton)
            {
                @* Alinda Gold Residence revision (2026-08-10) —
                   CatalogueComingSoonHeroToast opts a project into also
                   firing the toast straight from the Hero, on top of the
                   existing anchor scroll (both attributes coexist on the
                   same <a>; the toast's click listener never calls
                   preventDefault, so the browser still navigates to
                   #project-catalogue). False for every other project
                   (including La Fiore Karabağ 2. Etap/Kuyulu AVM, whose
                   CatalogueComingSoon is true but this flag is not), so
                   their Hero button keeps its original scroll-only
                   behavior, byte-identical to before. *@
                if (Model.CatalogueComingSoonHeroToast)
                {
                    <a class="btn btn-hero-segment btn-hero-segment--accent" href="#project-catalogue" data-toast-trigger data-toast-message="Proje kataloğu yakında eklenecektir.">Kataloğu İncele</a>
                }
                else
                {
                    <a class="btn btn-hero-segment btn-hero-segment--accent" href="#project-catalogue">Kataloğu İncele</a>
                }
            }
            <a class="btn btn-hero-segment btn-hero-segment--contact" href="/contact">Size Ulaşalım</a>
        </div>
        @{
            var scrollIndicatorModel = new AncinInsaat.Models.ScrollIndicatorModel
            {
                TargetId = Model.ScrollTargetId,
                Label = "Aşağı kaydır",
                CssClass = "scroll-indicator--on-dark"
            };
        }
        <partial name="_ScrollIndicator" model="scrollIndicatorModel" />
    </div>
</section>
