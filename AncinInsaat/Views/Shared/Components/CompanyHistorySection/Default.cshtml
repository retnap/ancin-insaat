@model CompanyHistorySectionViewModel

@*
    Layout ordering per the project owner's 2026-07-28 layout-hierarchy
    request, closely matching
    Inspirationals/Terzioglu/terzioglu-zaman-tuneli.png, updated by the
    2026-08-03 Timeline header redesign:
    1. Shared _TimelineHeader (oversized decorative watermark + centered
       readable heading) — full width, its own row at the very top,
       above the two-column content below.
    2. Two-column row: the left column stacks VideoShowcase (small
       teaser) directly above HistoryInfoPanel (small title + prev/next
       — nothing else); the right column is the independent
       HistoryCarousel, unchanged.

    data-reveal-group nests two levels (grid -> info column ->
    HistoryInfoPanel's own title/nav) so the fade-in stagger follows the
    requested order: video, small title, arrows, cards. _TimelineHeader
    carries its own standalone data-reveal. _HistoryCarousel's own track
    keeps its separate nested group for the cards, independent of this
    ordering.
*@

<section class="section company-history" id="company-history" aria-labelledby="@Model.Header.HeadingId">
    <div class="container">
        <partial name="_TimelineHeader" model="Model.Header" />
        <div class="company-history-grid" data-reveal-group>
            <div class="company-history-info-col" data-reveal-group>
                <partial name="_VideoShowcase" model="Model.Video" />
                <partial name="_HistoryInfoPanel" model="Model.InfoPanel" />
            </div>
            <div class="company-history-carousel-col" data-reveal>
                <partial name="_HomeTimelineCarousel" model="Model.Carousel" />
            </div>
        </div>
    </div>
</section>
