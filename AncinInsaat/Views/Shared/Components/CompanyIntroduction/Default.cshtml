@model CompanyIntroductionViewModel

@*
    "intro" (before Mission & Vision) vs "closing" (after it) — see
    CompanyIntroductionViewComponent. Neither renders a heading — the
    project owner's 2026-08-13 corrective instruction removed the
    "KİMİZ" / "Aydın'da Yarım Asırlık Bir Yolculuk" heading entirely,
    with "Hakkımızda" (About/Index.cshtml) remaining the only heading
    at the top of the page.
*@

<section class="section about-text" id="@Model.SectionId">
    <div class="container">
        <div class="about-text-column">
            @foreach (var paragraph in Model.Paragraphs)
            {
                <p class="about-text-paragraph">@paragraph</p>
            }
        </div>
    </div>
</section>
