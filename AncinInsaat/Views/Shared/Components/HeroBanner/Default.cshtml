@model HeroBannerViewModel

@{
    var heroStyle = Model.BackgroundImageUrl is not null
        ? $"--hero-bg-image: url('{Model.BackgroundImageUrl}')"
        : null;

    // Home Hero title typography match (Home Page revision #2, 2026-08-10):
    // when the featured project has a mapped heading font (ProjectHeroFontMap
    // — the same map every Project Detail Hero resolves from), the title
    // reuses that Hero's exact typography classes (font/weight/letter-
    // spacing/case/line-height/max-width/wrapping) and left inset. Today
    // only Nysa Gold is mapped, so this applies to it and no other project;
    // a project with no entry renders exactly as before. Only the title and
    // its immediate wrapper are affected — Home's own bottom-anchored
    // layout, background, buttons and Scroll Indicator stay untouched.
    var hasProjectHeadingStyle = !string.IsNullOrWhiteSpace(Model.HeadingFontModifierClass);

    // La Fiore Karabağ 2. Etap heading identity + 3-button hero actions
    // (2026-08-20 request) — same hasHeadingLogo gate the Project Detail
    // Hero uses (HeroBannerProjectDetail/Default.cshtml). Any other
    // featured project has a null HeadingLogoImageUrl, so it keeps the
    // plain text heading and single "Projeye Git" link exactly as before.
    var hasHeadingLogo = !string.IsNullOrWhiteSpace(Model.HeadingLogoImageUrl);

    // Font modifier class is only meaningful for the text heading below —
    // omitted here when a logo image renders instead, same as the Project
    // Detail Hero's own headingClass computation.
    var headingClass = "hero-heading" + (hasProjectHeadingStyle ? " hero-heading--project" + (hasHeadingLogo ? "" : $" {Model.HeadingFontModifierClass}") : "");
    var contentClass = "hero-content" + (hasProjectHeadingStyle ? " hero-content--start" : "");
    var headingLang = hasProjectHeadingStyle ? "en" : null;
    var headingLogoImgClass = "hero-heading-logo-img" + (string.IsNullOrWhiteSpace(Model.HeadingLogoImgModifierClass) ? "" : $" {Model.HeadingLogoImgModifierClass}");

    // La Fiore Karabağ 2. Etap Home Hero vertical alignment match (2026-08-20
    // request) — reuses .hero--project-detail (site.css) as-is, the exact
    // same modifier the Project Detail Hero itself carries, so this heading
    // is vertically centered identically to how it already sits on the
    // Project Detail page rather than Home's own bottom-anchored default.
    // Gated on hasHeadingLogo, which is only ever true for this one project
    // (HeroBannerViewComponent), so every other featured project keeps
    // Home's original bottom-anchored layout untouched.
    var heroSectionClass = "hero hero--overlap-navbar hero--full-viewport" + (hasHeadingLogo ? " hero--project-detail" : "");
}

@* Nysa Gold Residence reference redesign (2026-08-07), reused on the Home
   Hero (2026-08-10): hero--overlap-navbar pulls the Hero up under the
   sticky Navbar so site.js's "Navbar — Transparent Over Hero" observer
   (scoped by this class, not by page) can toggle it transparent while the
   Hero is in view — same architecture as every Project Detail Hero, no
   second implementation. *@
<section class="@heroSectionClass" style="@heroStyle" aria-labelledby="hero-heading">
    <div class="hero-bg" aria-hidden="true"></div>

    <nav class="hero-social-nav" aria-label="Sosyal medya">
        @await Component.InvokeAsync("SocialMedia")
    </nav>

    <div class="container hero-inner">
        <div class="@contentClass">
            @if (hasHeadingLogo)
            {
                <h1 id="hero-heading" class="@headingClass">
                    <span class="hero-heading-lockup">
                        <img src="@Model.HeadingLogoImageUrl" alt="@Model.Heading" class="@headingLogoImgClass">
                        @if (!string.IsNullOrWhiteSpace(Model.HeadingBadgeImageUrl))
                        {
                            <img src="@Model.HeadingBadgeImageUrl" alt="" aria-hidden="true" class="hero-heading-badge-img">
                        }
                    </span>
                </h1>
            }
            else
            {
                <h1 id="hero-heading" class="@headingClass" lang="@headingLang">@Model.Heading</h1>
                <p class="hero-subheading">@Model.Subheading</p>
            }
        </div>
    </div>

    @* Down-arrow Scroll Indicator removed from the Home Hero specifically
       (2026-08-20 client request) — every other Hero (Project Detail,
       Standard) keeps its own _ScrollIndicator partial untouched. *@
    <div class="hero-bottom">
        @if (hasHeadingLogo)
        {
            @* La Fiore Karabağ 2. Etap 3-button hero actions (2026-08-20
               request) — reuses the same segmented bar as the Project
               Detail Hero (.hero-actions--attached/.btn-hero-segment*,
               HeroBannerProjectDetail/Default.cshtml) rather than a new
               button style, so "Projeye Git" → "Vaziyet Planı" →
               "Size Ulaşalım" look identical wherever they appear. *@
            <div class="hero-actions hero-actions--attached">
                @if (Model.ProjectCtaUrl is not null)
                {
                    <a class="btn btn-hero-segment btn-hero-segment--accent" href="@Model.ProjectCtaUrl">@Model.ProjectCtaLabel</a>
                }
                @if (!string.IsNullOrWhiteSpace(Model.SitePlanImageUrl))
                {
                    <button type="button"
                            class="btn btn-hero-segment btn-hero-segment--siteplan"
                            data-media-viewer-trigger
                            data-media-viewer-group="site-plan"
                            data-media-viewer-src="@Model.SitePlanImageUrl"
                            data-media-viewer-alt="@(Model.Heading) vaziyet planı">
                        Vaziyet Planı
                    </button>
                }
                <a class="btn btn-hero-segment btn-hero-segment--contact" href="/contact">Size Ulaşalım</a>
            </div>
        }
        else if (Model.ProjectCtaUrl is not null)
        {
            <a class="hero-project-cta" href="@Model.ProjectCtaUrl">@Model.ProjectCtaLabel</a>
        }
    </div>
</section>
