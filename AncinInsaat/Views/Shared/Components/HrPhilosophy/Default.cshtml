@model HrPhilosophyViewModel

<section class="section hr-philosophy" id="hr-philosophy" aria-labelledby="@Model.SectionHeader.HeadingId">
    <div class="container grid grid-cols-2 hr-philosophy-grid" data-reveal-group>
        <div class="hr-philosophy-content" data-reveal="left">
            <partial name="_SectionHeader" model="Model.SectionHeader" />
            @foreach (var paragraph in Model.Paragraphs)
            {
                <p class="hr-philosophy-paragraph">@paragraph</p>
            }
        </div>
        <div class="hr-philosophy-media" data-reveal="right">
            <partial name="_ImageBlock" model="Model.Image" />
        </div>
    </div>
</section>
