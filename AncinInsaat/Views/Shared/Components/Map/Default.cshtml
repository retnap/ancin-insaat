@model MapViewModel

<div class="map-component">
    @if (!string.IsNullOrWhiteSpace(Model.EmbedUrl))
    {
        <div class="map-component__embed">
            <iframe
                src="@Model.EmbedUrl"
                title="Ancın İnşaat konumu — Google Haritalar"
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade">
            </iframe>
        </div>
    }
    else
    {
        @* Static location photo (project owner-supplied, 2026-08-20) shown
           above the "Google Maps'te Aç" link until a real Google Maps
           embed URL is configured (see docs/14_Decisions.md). Non-empty
           alt: unlike the earlier generic illustration, this image is the
           actual office location, so it carries information for screen
           reader users too, alongside the visible link. *@
        <div class="map-component__placeholder">
            <img src="/images/company/ancin-konum.png" alt="Ançın İnşaat ofis konumu" loading="lazy" decoding="async" />
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.LinkUrl))
    {
        <a class="btn btn-secondary map-component__link" href="@Model.LinkUrl" target="_blank" rel="noopener noreferrer">
            Google Maps'te Aç
            <span class="sr-only">— yeni sekmede açılır</span>
        </a>
    }
</div>
