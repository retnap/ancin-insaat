@model ValuesIntroductionViewModel

@*
    Our Values "Introduction" (docs/03_PageBlueprints.md — Introduction
    phase, 2026-08-03). Folkart-reference revision, 2026-08-16: no section
    heading, just a full-width paragraph column directly under the page
    title — same treatment as About/CompanyIntroduction's "intro" call.
*@

<section class="section values-introduction" id="values-introduction">
    <div class="container">
        <div class="values-introduction-column">
            @foreach (var paragraph in Model.Paragraphs)
            {
                <p class="values-introduction-paragraph">@paragraph</p>
            }
        </div>
    </div>
</section>
