@model BreadcrumbViewModel

<nav class="breadcrumb-nav container" aria-label="Breadcrumb">
    <ol class="breadcrumb">
        @for (var i = 0; i < Model.Items.Count; i++)
        {
            var item = Model.Items[i];
            var isLast = i == Model.Items.Count - 1;
            <li class="breadcrumb-item">
                @if (item.Url is not null && !isLast)
                {
                    <a class="breadcrumb-link" href="@item.Url">@item.Label</a>
                    <span class="breadcrumb-separator" aria-hidden="true">/</span>
                }
                else
                {
                    <span class="breadcrumb-current" aria-current="page">@item.Label</span>
                }
            </li>
        }
    </ol>
</nav>
