@model MissionVisionViewModel

@*
    About Us "Mission & Vision" (2026-08-13 Folkart-reference revision).
    A single darkened image panel — --mv-bg-image is read by .mission-vision-panel
    in site.css the same way Hero Banner reads --hero-bg-image, so replacing
    Model.BackgroundImageUrl with a real photo later needs no markup change.
*@

<section class="section mission-vision" id="about-mission-vision" aria-label="Misyon ve Vizyon">
    <div class="container">
        <div class="mission-vision-panel" style="--mv-bg-image: url('@Model.BackgroundImageUrl')">
            <div class="mission-vision-block">
                <h2 class="mission-vision-label">@Model.MissionLabel</h2>
                <p class="mission-vision-text">@Model.MissionText</p>
            </div>
            <div class="mission-vision-block">
                <h2 class="mission-vision-label">@Model.VisionLabel</h2>
                <p class="mission-vision-text">@Model.VisionText</p>
            </div>
        </div>
    </div>
</section>
