@model FooterViewModel

<div class="container footer-inner">

    <div class="footer-row">

        <div class="footer-brand">
            <a href="/" class="footer-logo" aria-label="Ancın İnşaat — Home">
                <img src="~/images/logos/ancin-logo-2-removebg.png" alt="Ancın İnşaat" width="98" height="40" />
            </a>
            <p class="footer-copyright">&copy; @Model.CopyrightYear Ancın İnşaat. All rights reserved.</p>
        </div>

        <address class="footer-contact">
            <p>@Model.AddressLine1<br />@Model.AddressLine2</p>
            <p><a class="footer-link" href="tel:@Model.PhoneHref">@Model.Phone</a></p>
            <p><a class="footer-link" href="mailto:@Model.Email">@Model.Email</a></p>
        </address>

        <div class="footer-follow">
            <h2 class="footer-heading">Follow Us</h2>
            @await Component.InvokeAsync("SocialMedia")
        </div>

    </div>

</div>
