@model FooterViewModel

<div class="container footer-inner">

    <div class="footer-grid">

        <div class="footer-column footer-column--company">
            <a href="/" class="footer-logo" aria-label="Ançın İnşaat — Home">
                <img src="~/images/logos/ancin-logo.png" alt="Ançın İnşaat" width="114" height="40" />
            </a>
            <p class="footer-tagline">@Model.CompanyTagline</p>
            <address class="footer-address">
                <p>@Model.Address</p>
                <p><a class="footer-link" href="tel:@Model.PhoneHref">@Model.Phone</a></p>
                <p><a class="footer-link" href="mailto:@Model.Email">@Model.Email</a></p>
            </address>
            @await Component.InvokeAsync("SocialMedia")
        </div>

        <div class="footer-column">
            <h2 class="footer-heading">CORPORATE</h2>
            <ul class="footer-links">
                @foreach (var link in Model.CorporateLinks)
                {
                    <li><a class="footer-link" href="@link.Url">@link.Label</a></li>
                }
            </ul>
        </div>

        <div class="footer-column">
            <h2 class="footer-heading">PEOPLE FIRST</h2>
            <ul class="footer-links">
                @foreach (var link in Model.PeopleFirstLinks)
                {
                    <li><a class="footer-link" href="@link.Url">@link.Label</a></li>
                }
            </ul>
        </div>

        <div class="footer-column">
            <h2 class="footer-heading">EXPLORE</h2>
            <ul class="footer-links">
                @foreach (var link in Model.ExploreLinks)
                {
                    <li><a class="footer-link" href="@link.Url">@link.Label</a></li>
                }
            </ul>
        </div>

    </div>

    <div class="footer-bottom">
        <p>&copy; @Model.CopyrightYear Ançın İnşaat. All rights reserved.</p>
    </div>

</div>
