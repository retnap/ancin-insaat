@model CtaBannerViewModel

<section class="cta-banner">
    <a class="cta-banner-link" href="@Model.LinkUrl">
        <div class="container cta-banner-inner">
            <span class="cta-banner-heading">@Model.Heading</span>
            <svg class="cta-banner-arrow" viewBox="0 0 24 24" width="1em" height="1em" aria-hidden="true">
                <path d="M4 12h16M14 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
        </div>
    </a>
</section>
