@model SocialMediaViewModel

<ul class="social-links @(Model.OnLight ? "social-links--on-light" : "")">
    @foreach (var link in Model.Links)
    {
        <li>
            <a class="social-link"
               href="@link.Url"
               target="_blank"
               rel="noopener noreferrer"
               aria-label="@(link.Platform) — opens in a new tab">
                <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
                    @* Static, developer-authored markup — see SocialMediaViewModel.IconMarkup. *@
                    @Html.Raw(link.IconMarkup)
                </svg>
            </a>
        </li>
    }
</ul>
