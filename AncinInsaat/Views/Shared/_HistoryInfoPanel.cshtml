@model HistoryInfoPanelModel

@*
    Navigation only, per the project owner's explicit request — no years,
    no timeline line, no cards. Prev/Next drive the matching
    _HistoryCarousel (same Model.Id), wired up in site.js via
    data-history-info-panel / data-history-carousel. data-reveal-group
    gives the small title and the arrows their own slight stagger
    (2026-07-28 layout-hierarchy request), nested inside
    CompanyHistorySection's outer groups.
*@

<div class="history-info-panel" data-history-info-panel="@Model.Id" data-reveal-group>
    <p class="history-info-panel-title" data-reveal>@Model.Title</p>
    <div class="history-info-panel-nav" data-reveal>
        <button type="button" class="history-nav-btn" data-history-prev aria-label="Önceki">
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
                <path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
        </button>
        <button type="button" class="history-nav-btn" data-history-next aria-label="Sonraki">
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
                <path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
        </button>
    </div>
</div>
