@model ContactPageViewModel

@* Contact Form + Contact Information (docs/03_PageBlueprints.md "Page —
   Contact"). Folkart-reference revision (2026-08-17) — form left,
   information right, matching the supplied "İletişim" screenshot (the
   original layout had information left/form right; data-reveal="left"/
   "right" are swapped along with the panels below so the arrival
   direction still matches each panel's new physical side). The
   information panel's former visible _SectionHeader ("İletişim
   Bilgileri" / "Bize Ulaşın" / description) is dropped — the reference
   goes straight from the page's own "İletişim" heading/intro into the
   category list with no second header in between — replaced by a
   visually-hidden heading so the column keeps an accessible name.
   ContactController re-renders this same partial (via Views/Contact/Index)
   on an invalid POST, so ModelState errors below reflect the submitted
   values. *@

@{
    bool IsInvalid(string key) => ViewData.ModelState.TryGetValue(key, out var entry) && entry.Errors.Count > 0;
}

<div class="contact-info-form">
    <div class="contact-form-panel" data-reveal="left">
        @if (Model.ShowSuccess)
        {
            <partial name="_SuccessMessage" model="@(new SuccessMessageModel
            {
                Title = "Mesajınız Alındı",
                Description = "İlginiz için teşekkür ederiz. Ekibimiz en kısa sürede sizinle iletişime geçecektir."
            })" />
        }
        else
        {
            <form class="contact-form" asp-controller="Contact" asp-action="Submit" method="post" aria-labelledby="contact-form-heading">
                <h2 id="contact-form-heading" class="sr-only">İletişim Formu</h2>

                @if (!ViewData.ModelState.IsValid)
                {
                    <p class="form-error form-summary-error" role="alert">Lütfen formdaki hataları düzeltip tekrar deneyin.</p>
                }

                <p class="contact-form__required-note"><span aria-hidden="true">*</span> işaretli alanlar zorunludur.</p>

                @* Row pairing follows the reference's "Adınız Soyadınız / İlgili
                   Proje" two-column row — there is no project-selector field in
                   this form, so Konu (Subject, the closest existing equivalent
                   free-text field) fills that second column instead of
                   inventing one. Email and Phone each keep their own full-width
                   row below, matching the reference. *@
                <div class="form-row">
                    <div class="form-field">
                        <label asp-for="Form.FullName">Ad Soyad <span class="required-mark" aria-hidden="true">*</span></label>
                        <input asp-for="Form.FullName" type="text" autocomplete="name" required maxlength="200" minlength="2"
                               aria-invalid="@(IsInvalid("Form.FullName") ? "true" : "false")" aria-describedby="FullName-error" />
                        <span asp-validation-for="Form.FullName" id="FullName-error" class="form-error"></span>
                    </div>

                    <div class="form-field">
                        <label asp-for="Form.Subject">Konu</label>
                        <input asp-for="Form.Subject" type="text" maxlength="200"
                               aria-invalid="@(IsInvalid("Form.Subject") ? "true" : "false")" aria-describedby="Subject-error" />
                        <span asp-validation-for="Form.Subject" id="Subject-error" class="form-error"></span>
                    </div>
                </div>

                <div class="form-field">
                    <label asp-for="Form.Email">E-posta <span class="required-mark" aria-hidden="true">*</span></label>
                    <input asp-for="Form.Email" type="email" autocomplete="email" required maxlength="320"
                           aria-invalid="@(IsInvalid("Form.Email") ? "true" : "false")" aria-describedby="Email-error" />
                    <span asp-validation-for="Form.Email" id="Email-error" class="form-error"></span>
                </div>

                <div class="form-field">
                    <label asp-for="Form.Phone">Telefon</label>
                    <input asp-for="Form.Phone" type="tel" autocomplete="tel" maxlength="50"
                           aria-invalid="@(IsInvalid("Form.Phone") ? "true" : "false")" aria-describedby="Phone-error" />
                    <span asp-validation-for="Form.Phone" id="Phone-error" class="form-error"></span>
                </div>

                <div class="form-field">
                    <label asp-for="Form.Message">Mesajınız <span class="required-mark" aria-hidden="true">*</span></label>
                    <textarea asp-for="Form.Message" required maxlength="2000" minlength="10" rows="6"
                              aria-invalid="@(IsInvalid("Form.Message") ? "true" : "false")" aria-describedby="Message-error"></textarea>
                    <span asp-validation-for="Form.Message" id="Message-error" class="form-error"></span>
                </div>

                @* Honeypot — aria-hidden removes the whole block from the accessibility
                   tree and tabindex="-1" keeps it out of keyboard tab order, so a real
                   (sighted or assistive-tech) visitor can never reach or fill it; a bot
                   that blindly fills every <input> does. See ContactFormViewModel.Website
                   and ContactController.Submit. *@
                <div class="contact-form-honeypot" aria-hidden="true">
                    <label asp-for="Form.Website">Website</label>
                    <input asp-for="Form.Website" type="text" tabindex="-1" autocomplete="off" />
                </div>

                @* Red fill / white text (2026-08-17 revision) — .btn supplies
                   the shared shell (sizing, touch target, shape); fill/hover
                   colours come from the page-scoped .contact-form__submit
                   rule below rather than .btn-primary, since the hover here
                   is a subtle lighten, not the sitewide invert-to-white. *@
                <button type="submit" class="btn contact-form__submit" data-contact-form-submit>Gönder</button>
            </form>
        }
    </div>

    <div class="contact-info-panel" data-reveal="right">
        <h2 id="contact-info-heading" class="sr-only">İletişim Bilgileri</h2>
        <partial name="_InformationCard" model="Model.InformationCard" />
    </div>
</div>
