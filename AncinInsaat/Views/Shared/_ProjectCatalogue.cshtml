@model AncinInsaat.Models.ProjectDetailViewModel

@* Project Catalogue (docs/03_PageBlueprints.md) — full-bleed cinematic CTA,
   Project Detail redesign 2026-07-31. Reuses the Hero's own banner image for
   the background (bookending the page) rather than requiring a dedicated
   asset. Details.cshtml only composes this partial when Model.CatalogueUrl
   is present. Taller "featured" treatment (Nysa Gold Residence reference
   redesign, 2026-08-07) rolled out to every project (2026-08-08). *@

@{
    // Nysa Gold, Le Jardin, La Via Villalar 1. Etap logo lockup (2026-08-28
    // client request) — same banner-logo assets already used as the Hero's
    // heading image (see HeroBannerProjectDetailViewComponent's
    // HeadingLogoImageUrls), reused here in place of the plain-text project
    // name. Every other slug keeps the text eyebrow below unchanged.
    var catalogueEyebrowLogoUrl = Model.Slug switch
    {
        "nysa-gold" => "/images/projects/nysa-gold/banner/nysa gold logo_last.png",
        "le-jardin" => "/images/projects/le-jardin/banner/le jardin logo.png",
        "kuyulu-la-via-villalar-birinci-etap" => "/images/projects/kuyulu-la-via-villalar-birinci-etap/banner/lavia  logo.png",
        _ => null
    };

    // La Fiore Karabağ (1. Etap) spacing fix (2026-09-11) — Details.cshtml
    // excludes this slug from the Daire Planları section (it has none), so
    // this is the only project on the site where this CTA is immediately
    // followed by the shared layout's CtaBanner ("Tüm Projeler") strip
    // instead of Daire Planları's own .section padding-block — both this
    // CTA and CtaBanner use near-black backgrounds, so with nothing else in
    // between they read as one continuous block. Every other project
    // rendering this CTA keeps Daire Planları right after it, so this stays
    // scoped to this one slug rather than changing .project-catalogue-cta's
    // own padding-block for everyone (see .project-catalogue-cta--standalone-bottom
    // in site.css).
    var isStandaloneBeforeCtaBanner = Model.Slug == "la-fiore-karabag";
    var catalogueCtaClass = "project-catalogue-cta project-catalogue-cta--featured" + (isStandaloneBeforeCtaBanner ? " project-catalogue-cta--standalone-bottom" : "");
}

<section class="@catalogueCtaClass" id="project-catalogue" style="--catalogue-bg-image: url('@Model.HeroBackgroundImageUrl')" aria-labelledby="project-catalogue-heading">
    <div class="project-catalogue-cta-bg" aria-hidden="true"></div>
    <div class="container project-catalogue-cta-inner" data-reveal>
        <div class="project-catalogue-cta-text">
            @if (catalogueEyebrowLogoUrl is not null)
            {
                <img src="@catalogueEyebrowLogoUrl" alt="@Model.Name" class="project-catalogue-cta-eyebrow-logo">
            }
            else
            {
                <p class="project-catalogue-cta-eyebrow">@Model.Name</p>
            }
            <h2 id="project-catalogue-heading" class="project-catalogue-cta-heading">Projeyi Detaylıca Keşfedin</h2>
        </div>
        @if (Model.CatalogueComingSoon)
        {
            @* La Fiore Karabağ 2. Etap Vaziyet Planı/Concept/Gallery phase
               (2026-08-09) — this project's real catalogue file exists on
               disk (CatalogueUrl is non-null, which is why this section
               renders at all — see Details.cshtml), but the client wants the
               button to announce it's coming soon rather than download it
               yet. CatalogueComingSoon is false for every other project, so
               they keep the real download link below unchanged. *@
            <button type="button" class="btn btn-primary project-catalogue-cta-button" data-toast-trigger data-toast-message="Proje kataloğu yakında eklenecektir.">Proje Kataloğunu İndir</button>
        }
        else
        {
            <a class="btn btn-primary project-catalogue-cta-button" href="@Model.CatalogueUrl" download>Proje Kataloğunu İndir</a>
        }
    </div>
</section>
