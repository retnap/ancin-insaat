@{
    // Falls back to the plain ViewData["Title"] convention (Projects/Details,
    // Error) for any page that hasn't been wired to ISeoService yet — only
    // Home sets ViewData["Seo"] so far (docs/14_Decisions.md).
    var seo = ViewData["Seo"] as AncinInsaat.Models.SeoModel;
    var pageTitle = seo?.Title ?? ViewData["Title"] as string ?? "Ançın İnşaat";
}
<!DOCTYPE html>
<html lang="tr" class="no-js">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@pageTitle</title>
    @if (seo is not null)
    {
        <meta name="description" content="@seo.Description" />
        <link rel="canonical" href="@seo.CanonicalUrl" />

        <meta property="og:type" content="website" />
        <meta property="og:title" content="@pageTitle" />
        <meta property="og:description" content="@seo.Description" />
        <meta property="og:url" content="@seo.CanonicalUrl" />
        <meta property="og:image" content="@seo.OgImageUrl" />
        <meta property="og:locale" content="tr_TR" />

        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content="@pageTitle" />
        <meta name="twitter:description" content="@seo.Description" />
        <meta name="twitter:image" content="@seo.OgImageUrl" />
    }
    @await Component.InvokeAsync("SeoStructuredData")
    <link rel="stylesheet" href="~/css/site.css" />
    @* Blocking, before any body content paints: flips no-js -> js so
       [data-reveal] can start hidden in CSS (site.css Section 18) only
       when script is actually running. Without this, disabling
       JavaScript would leave scroll-revealed content invisible forever —
       see docs/05_Animations.md "Content should remain usable even if
       animations are disabled." *@
    <script>document.documentElement.classList.replace('no-js', 'js');</script>
</head>
<body>
    <a href="#main-content" class="skip-link">Skip to content</a>

    <header class="navbar">
        @await Component.InvokeAsync("Navbar")
    </header>

    <main id="main-content" tabindex="-1">
        @RenderBody()
    </main>

    @await Component.InvokeAsync("CtaBanner")

    @await Component.InvokeAsync("PartnerLogos")

    <footer class="footer">
        @await Component.InvokeAsync("Footer")
    </footer>

    @await Component.InvokeAsync("FloatingContactButton")

    @* Rendered before site.js: any page-specific vendor script a section
       here provides (e.g. Home's Embla Carousel) needs to already be
       loaded by the time site.js runs, since site.js reads globals like
       window.EmblaCarousel synchronously at parse time rather than
       waiting for DOMContentLoaded. *@
    @await RenderSectionAsync("Scripts", required: false)
    <script src="~/js/site.js"></script>
</body>
</html>
