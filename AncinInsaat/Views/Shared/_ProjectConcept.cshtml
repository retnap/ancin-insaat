@model AncinInsaat.Models.ProjectDetailViewModel

@* Concept section (Project Detail redesign, 2026-07-31) — replaces the
   previous plain "Project Overview" block. Large media left, text panel
   right (reversed to stacked media-then-panel on mobile), each revealing
   independently via the existing [data-reveal] utility's new left/right
   direction modifiers. Folds the Project Information summary into the text
   panel rather than a separate aside, since the new page flow
   (docs/03_PageBlueprints.md, as amended by this redesign) has no standalone
   "Project Overview" section of its own. *@

@if (Model.ConceptSlides.Count > 0)
{
    @* Concept Carousel (Davutlar D Latis Concept redesign, 2026-08-09;
       generalized to mixed video/image media, Le Jardin Concept carousel
       generalization, 2026-08-09) — recomposed to match Inspirationals/
       Folkart/folkart-konsept-inspiration-2.png's actual proportions almost
       1:1: a noticeably smaller, ~1259:730 media card with a blue panel (the
       reference's own blue, not this site's terracotta) overlapping its left
       edge. Only rendered when a project has 1+ ProjectConceptVideo/
       ProjectConceptImage rows — every other project keeps rendering the
       original single-video/photo Concept card below completely unchanged.
       One [data-concept-carousel-slide]/[data-concept-carousel-panel-slide]
       per slide, whichever media type it is (Model.ConceptSlides is already
       merged and ordered — see ProjectDetailViewModel.ConceptSlides), both
       tracks slid together by site.js via transform: translateX (see
       "Concept — Video Carousel" there — the name predates this
       generalization but the binding is already data-attribute-driven and
       needed no changes). A video slide's Play opens the shared full-
       viewport modal further below rather than inline, so switching slides
       never starts or stops playback; an image slide's whole card is a
       Media Viewer trigger instead, same "whole card is a plain button"
       pattern as .gallery-card. *@
    var slides = Model.ConceptSlides;
    var hasVideoSlide = slides.Any(slide => slide.MediaType == AncinInsaat.Models.ConceptMediaType.Video);

    <div class="project-concept project-concept-carousel-section">
        <p class="project-concept-watermark" aria-hidden="true">KONSEPT</p>

        <div class="concept-carousel" data-concept-carousel>
            <div class="concept-carousel-media" data-reveal="left">
                <div class="concept-carousel-track" data-concept-carousel-track>
                    @for (var i = 0; i < slides.Count; i++)
                    {
                        var slide = slides[i];
                        <div class="concept-carousel-slide" data-concept-carousel-slide aria-hidden="@(i == 0 ? "false" : "true")">
                            <img class="concept-carousel-poster" src="@slide.PosterUrl" alt="@slide.Title" loading="@(i == 0 ? "eager" : "lazy")" decoding="async" />
                            @if (slide.MediaType == AncinInsaat.Models.ConceptMediaType.Video)
                            {
                                <button type="button"
                                        class="concept-carousel-play"
                                        data-concept-carousel-play
                                        data-video-src="@slide.VideoUrl"
                                        data-poster-src="@slide.PosterUrl"
                                        data-video-title="@slide.Title"
                                        tabindex="@(i == 0 ? "0" : "-1")"
                                        aria-label="@($"{slide.Title} videosunu oynat")">
                                    <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true">
                                        <circle cx="12" cy="12" r="10.5" fill="none" stroke="currentColor" stroke-width="1.5" />
                                        <path d="M10 8l6 4-6 4V8z" fill="currentColor" />
                                    </svg>
                                </button>
                            }
                            else
                            {
                                <button type="button"
                                        class="concept-carousel-slide-trigger"
                                        data-media-viewer-trigger
                                        data-media-viewer-group="concept"
                                        data-media-viewer-src="@slide.LightboxUrl"
                                        data-media-viewer-alt="@slide.Title"
                                        tabindex="@(i == 0 ? "0" : "-1")"
                                        aria-label="@($"{slide.Title} görselini büyüt")">
                                </button>
                            }
                        </div>
                    }
                </div>
            </div>

            <div class="concept-carousel-panel" data-reveal="right">
                <div class="concept-carousel-panel-track" data-concept-carousel-panel-track>
                    @for (var i = 0; i < slides.Count; i++)
                    {
                        var slide = slides[i];
                        <div class="concept-carousel-panel-slide" data-concept-carousel-panel-slide aria-hidden="@(i == 0 ? "false" : "true")">
                            <p class="concept-carousel-eyebrow">@slide.Eyebrow</p>
                            <h2 class="concept-carousel-title" id="@(i == 0 ? "project-concept-heading" : null)" data-concept-carousel-heading>@slide.Title</h2>
                            <p class="concept-carousel-desc">@slide.Description</p>
                        </div>
                    }
                </div>

                @if (slides.Count > 1)
                {
                    <div class="concept-carousel-nav-group">
                        <button type="button" class="concept-carousel-nav concept-carousel-prev" data-concept-carousel-prev aria-label="Önceki">
                            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                                <path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                        </button>
                        <button type="button" class="concept-carousel-nav concept-carousel-next" data-concept-carousel-next aria-label="Sonraki">
                            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                                <path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>

    @* Video modal — rendered when this project's carousel has 1+ video
       slides, OR the Gallery has 1+ video cards (Gallery video support,
       2026-08-09 — one shared player, never two implementations). An
       all-image project with no Gallery videos either (e.g. La Fiore
       Karabağ 2. Etap) renders no modal at all, matching its previous
       behavior exactly. Reuses
       the site's existing .video-modal/.video-modal-backdrop/.video-modal-
       panel/.video-modal-close shell (Views/Shared/_VideoShowcase.cshtml,
       site.css Section 19) rather than inventing a second visual language
       for "a video in a lightbox"; only .concept-video-modal-frame is new,
       since this modal's <video> has no src/aspect-ratio baked in at render
       time the way _VideoShowcase's does — site.js sets it per click from
       whichever slide's Play button was pressed. Deliberately a plain
       native <video controls> rather than a hand-built scrubber/volume/
       speed bar: modern browsers' own controls already cover every control
       the brief calls for (play/pause, scrubber, time, volume, fullscreen,
       playback speed, seeking), so a custom control bar would only add
       surface area (and its own accessibility bugs) without giving the
       visitor anything more. Rendered as a sibling of .project-concept (not
       nested inside it) so its position: fixed is never affected by an
       ancestor's [data-reveal] transform — same reasoning as
       _VideoShowcase's own trigger/modal split. site.js owns open/close,
       Esc, backdrop-click and body-scroll-lock (same shape as
       _VideoShowcase/_MediaViewer's own modals), and always reopens the
       carousel at whichever slide was showing when Play was clicked — the
       modal never touches the carousel's own state.
    *@
    @if (hasVideoSlide || Model.GalleryImages.Any(image => image.VideoUrl is not null))
    {
        <div class="video-modal" id="concept-video-modal" role="dialog" aria-modal="true" aria-label="Video" data-concept-video-modal hidden>
            <div class="video-modal-backdrop" data-concept-video-modal-close></div>
            <div class="video-modal-panel concept-video-modal-panel">
                <button type="button" class="video-modal-close" data-concept-video-modal-close aria-label="Kapat">
                    <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
                        <path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </button>
                <div class="concept-video-modal-frame">
                    <video class="concept-video-modal-video" data-concept-video-modal-video controls playsinline preload="none"></video>
                </div>
            </div>
        </div>
    }
}
else
{
    @* Nysa Gold Residence reference redesign (2026-08-07), rolled out to
       every project (2026-08-08) — inspired by (not copying)
       Inspirationals/Folkart/folkart-konsept-inspiration-2.png: oversized
       "KONSEPT" watermark behind a media card (left) with a floating panel
       overlapping it (right). Reuses Timeline/Gallery's existing
       decorative-watermark typography treatment (font/weight/opacity/
       shadow — site.css's "Timeline Header (shared)" section) rather than
       the _TimelineHeader banner component itself, since here the
       watermark sits behind the media card rather than above the section —
       a genuinely different composition, per the brief's own layout
       description. Prev/Next page through the project's own "Exterior"
       gallery images (no new entities); the play button opens the
       currently-shown image in the shared Media Viewer — there is no video
       asset anywhere in the data model, so this is a real, functional
       "view larger" interaction rather than a stub. Projects with fewer
       than 2 Exterior-tagged images fall back to a single static image via
       Model.ConceptImageUrl below, so this degrades gracefully wherever
       gallery images aren't category-tagged yet. *@
    var hasConceptVideo = !string.IsNullOrWhiteSpace(Model.ConceptVideoUrl) && !string.IsNullOrWhiteSpace(Model.ConceptVideoPosterUrl);

    var exteriorImages = Model.GalleryImages
        .Where(image => string.Equals(image.Category, "Exterior", StringComparison.OrdinalIgnoreCase))
        .ToList();
    if (exteriorImages.Count == 0)
    {
        exteriorImages = new List<AncinInsaat.Models.GalleryImageModel>
        {
            new() { Src = Model.ConceptImageUrl, ThumbnailSrc = Model.ConceptImageUrl, Alt = Model.Name + " konsept görseli" }
        };
    }
    var firstConceptImage = exteriorImages[0];

    <div class="project-concept project-concept--featured">
        <p class="project-concept-watermark" aria-hidden="true">KONSEPT</p>

        @* Concept Video (Davutlar D Latis Media phase, 2026-08-09) — poster
           image + centered Play button, identical markup/position to the
           photo case below, but Play swaps the poster for an inline,
           preload="none" <video> (data-concept-video-play, not a Media
           Viewer trigger) instead of opening the lightbox. Only rendered
           when a project has both a video and a poster; every other project
           keeps the exterior-photo carousel exactly as before. *@
        @if (hasConceptVideo)
        {
            <div class="project-concept-media project-concept-media--featured" data-reveal="left" data-concept-video-card>
                <img data-concept-video-poster src="@Model.ConceptVideoPosterUrl" alt="@(Model.Name) konsept videosu" loading="lazy" decoding="async" />
                <video data-concept-video src="@Model.ConceptVideoUrl" poster="@Model.ConceptVideoPosterUrl" preload="none" playsinline hidden></video>
                <button type="button" class="project-concept-play" data-concept-video-play aria-label="Videoyu oynat">
                    <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true">
                        <circle cx="12" cy="12" r="10.5" fill="none" stroke="currentColor" stroke-width="1.5" />
                        <path d="M10 8l6 4-6 4V8z" fill="currentColor" />
                    </svg>
                </button>
            </div>

            <div class="project-concept-panel project-concept-panel--featured" data-reveal="right">
                <h2 id="project-concept-heading" class="project-concept-heading-featured">@Model.Name</h2>

                @if (!string.IsNullOrWhiteSpace(Model.ConceptDescription))
                {
                    <p class="project-concept-intro">@Model.ConceptDescription</p>
                }
                else if (!string.IsNullOrWhiteSpace(Model.ShortDescription))
                {
                    <p class="project-concept-intro">@Model.ShortDescription</p>
                }
                else if (Model.DescriptionParagraphs.Count > 0)
                {
                    <p class="project-concept-intro">@Model.DescriptionParagraphs[0]</p>
                }
            </div>
        }
        else
        {
            <div class="project-concept-media project-concept-media--featured" data-reveal="left">
                <img data-concept-image src="@firstConceptImage.Src" alt="@firstConceptImage.Alt" loading="lazy" decoding="async" />
                <button type="button"
                        class="project-concept-play"
                        data-concept-play
                        data-media-viewer-trigger
                        data-media-viewer-group="concept"
                        data-media-viewer-src="@firstConceptImage.Src"
                        data-media-viewer-alt="@firstConceptImage.Alt"
                        aria-label="Görseli büyüt">
                    <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true">
                        <circle cx="12" cy="12" r="10.5" fill="none" stroke="currentColor" stroke-width="1.5" />
                        <path d="M10 8l6 4-6 4V8z" fill="currentColor" />
                    </svg>
                </button>
            </div>

            <div class="project-concept-panel project-concept-panel--featured" data-reveal="right">
                <h2 id="project-concept-heading" class="project-concept-heading-featured">@Model.Name</h2>

                @if (!string.IsNullOrWhiteSpace(Model.ConceptDescription))
                {
                    <p class="project-concept-intro">@Model.ConceptDescription</p>
                }
                else if (!string.IsNullOrWhiteSpace(Model.ShortDescription))
                {
                    <p class="project-concept-intro">@Model.ShortDescription</p>
                }
                else if (Model.DescriptionParagraphs.Count > 0)
                {
                    <p class="project-concept-intro">@Model.DescriptionParagraphs[0]</p>
                }

                @if (exteriorImages.Count > 1)
                {
                    <div class="project-concept-nav-group">
                        <button type="button" class="history-nav-btn project-concept-nav project-concept-prev" data-concept-prev aria-label="Önceki görsel">
                            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
                                <path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                        </button>
                        <button type="button" class="history-nav-btn project-concept-nav project-concept-next" data-concept-next aria-label="Sonraki görsel">
                            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
                                <path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                        </button>
                    </div>
                }
            </div>

            @if (exteriorImages.Count > 1)
            {
                <div hidden data-concept-images>
                    @foreach (var image in exteriorImages)
                    {
                        <span data-concept-image-item data-src="@image.Src" data-alt="@image.Alt"></span>
                    }
                </div>
            }
        }
    </div>
}
