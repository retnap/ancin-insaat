@* Title/description/canonical/OG come from ViewData["Seo"], set in
   HomeController.Index via ISeoService — see _Layout.cshtml's <head>. *@

@await Component.InvokeAsync("HeroBanner")

@await Component.InvokeAsync("CompanyOverview")

@await Component.InvokeAsync("CompanyHistorySection")

@await Component.InvokeAsync("ProjectsShowcase")

@* Home Hero "Vaziyet Planı" button (2026-08-20 request) needs the shared
   Media Viewer dialog present on the page, same as every Project Detail
   page (Views/Projects/Details.cshtml). *@
<partial name="_MediaViewer" />

@section Scripts {
    @* Embla Carousel + Autoplay plugin (vendored at wwwroot/lib/embla-carousel,
       v8.6.0 UMD builds), Home-page-only since ProjectsShowcase is the only
       section that uses it. Must load before site.js, which reads the
       window.EmblaCarousel / window.EmblaCarouselAutoplay globals these
       define to initialise the slider. *@
    <script src="~/lib/embla-carousel/embla-carousel.umd.min.js"></script>
    <script src="~/lib/embla-carousel/embla-carousel-autoplay.umd.min.js"></script>
}
